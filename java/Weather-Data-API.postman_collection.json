				{
					"name": "1.1 获取Wind元数据",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8081/api/weather/metadata/wind",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8081",
							"path": ["api", "weather", "metadata", "wind"]
						},
						"description": "获取风场数据的网格信息、时间范围等元数据"
					},
					"response": []
				},
				{
					"name": "1.2 获取Wind数据 (第0帧)",
